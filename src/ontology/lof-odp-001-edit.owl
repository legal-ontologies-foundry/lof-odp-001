# EDITORS' FILE. Edit this file in Protégé; never edit the release files.
# Term IRIs: https://w3id.org/lof/ODP001_nnnnnnn (see lof-odp-001-idranges.owl)

Ontology(<https://w3id.org/lof/odp-001.owl>
Import(<https://w3id.org/lof/odp-001/imports/bfo_import.owl>)
Annotation(dcterms:title "LOF-ODP-001: Legal Act and Legal Document"@en)
Annotation(dcterms:description "Ontology design pattern distinguishing three entities that legal information systems routinely conflate: the legal act (a process), the legal content it establishes (a generically dependent continuant), and the legal documents that carry that content (material entities). DRAFT for review by the LOF founding coordinators."@en)
Annotation(dcterms:license <https://creativecommons.org/licenses/by/4.0/>)
Annotation(dcterms:creator "David R. Koepsell")

# ---------------------------------------------------------------- classes

Declaration(Class(:0001000))
AnnotationAssertion(rdfs:label :0001000 "legal act"@en)
AnnotationAssertion(rdfs:comment :0001000 "BFO placement (LOF-P-004): a legal act unfolds in time and has temporal parts (offer and acceptance, the stages of a legislative vote), so it is a process. It is distinguished from the content it establishes, which outlives it."@en)
AnnotationAssertion(skos:example :0001000 "the signing of a residential lease; the enactment of a statute; the delivery of a judgment"@en)
SubClassOf(:0001000 ObjectSomeValuesFrom(obo:BFO_0000057 obo:BFO_0000040))

Declaration(Class(:0001001))
AnnotationAssertion(rdfs:label :0001001 "legal content"@en)
AnnotationAssertion(rdfs:comment :0001001 "BFO placement (LOF-P-004): the same statute or contract term can be concretized in many copies and survives the destruction of any one of them. That is the mark of a generically dependent continuant. Legal content corresponds to the Work and Expression levels in FRBR-based legal standards."@en)
AnnotationAssertion(skos:altLabel :0001001 "legal information content"@en)
AnnotationAssertion(skos:closeMatch :0001001 obo:IAO_0000030)
SubClassOf(:0001001 obo:BFO_0000031)

Declaration(Class(:0001002))
AnnotationAssertion(rdfs:label :0001002 "legal document"@en)
AnnotationAssertion(skos:definition :0001002 "A material entity that is the carrier of some legal content."@en)
AnnotationAssertion(rdfs:comment :0001002 "BFO placement (LOF-P-004): the particular signed paper, or the particular stored file, is a material entity that carries the content. Digital documents are treated as patterns in material storage media. Note that IAO's 'document' is an information content entity, so it corresponds to legal content here, not to legal document. Legal document corresponds to the Item level in FRBR-based legal standards. A legal document takes part in a legal act only as its instrument (performed by means of); otherwise it at most evidences the act (evidences)."@en)
SubClassOf(:0001002 obo:BFO_0000040)
SubClassOf(:0001002 ObjectSomeValuesFrom(obo:BFO_0000101 :0001001))

Declaration(Class(:0001003))
AnnotationAssertion(rdfs:label :0001003 "enactment"@en)
AnnotationAssertion(skos:definition :0001003 "A legal act in which a body with legislative authority establishes legal content of general application."@en)
SubClassOf(:0001003 :0001000)
SubClassOf(:0001003 ObjectSomeValuesFrom(:0001100 :0001001))

Declaration(Class(:0001004))
AnnotationAssertion(rdfs:label :0001004 "contract formation"@en)
AnnotationAssertion(skos:definition :0001004 "A legal act in which two or more parties establish legal content that binds them to one another."@en)
SubClassOf(:0001004 :0001000)
SubClassOf(:0001004 ObjectSomeValuesFrom(:0001100 :0001001))

DisjointClasses(:0001003 :0001004)

Declaration(Class(:0001005))
AnnotationAssertion(rdfs:label :0001005 "legal norm"@en)
AnnotationAssertion(skos:definition :0001005 "Legal content that requires, prohibits, or permits some kind of conduct."@en)
AnnotationAssertion(rdfs:comment :0001005 "The operative provisions of a statute, regulation, contract, or judgment. Legal positions (LOF-ODP-003) are grounded in legal norms. Corresponds to CCO 'process regulation' and its three kinds (process requirement, process prohibition, action permission); see the LOF to CCO bridge."@en)
AnnotationAssertion(skos:example :0001005 "a lease clause requiring rent to be paid by the first of the month; a statute prohibiting resuscitation of a person with a valid DNR order"@en)
SubClassOf(:0001005 :0001001)

Declaration(Class(:0001006))
AnnotationAssertion(rdfs:label :0001006 "legal definition"@en)
AnnotationAssertion(skos:definition :0001006 "Legal content that states what a term means for the purposes of some other legal content."@en)
AnnotationAssertion(rdfs:comment :0001006 "Corresponds to CCO 'descriptive information content entity'."@en)
AnnotationAssertion(skos:example :0001006 "the definitions section of a statute"@en)
SubClassOf(:0001006 :0001001)

Declaration(Class(:0001007))
AnnotationAssertion(rdfs:label :0001007 "legal designator"@en)
AnnotationAssertion(skos:definition :0001007 "Legal content that names or identifies some legal content or legal document, such as a title, a section number, or a citation."@en)
AnnotationAssertion(rdfs:comment :0001007 "Corresponds to CCO 'designative information content entity'. The natural point of attachment for identifier standards such as Akoma Ntoso eIds and ELI."@en)
AnnotationAssertion(skos:example :0001007 "'8 U.S.C. 1103(a)(3)'; the short title of an act"@en)
SubClassOf(:0001007 :0001001)

AnnotationAssertion(rdfs:comment :0001001 "A single body of legal content, such as a statute, typically has legal norms, legal definitions, and legal designators among its parts (BFO 'has continuant part'). It is therefore not itself a norm, a definition, or a designator as a whole."@en)

# ---------------------------------------------------------------- relations

Declaration(ObjectProperty(:0001100))
AnnotationAssertion(rdfs:label :0001100 "establishes"@en)
AnnotationAssertion(skos:definition :0001100 "A relation between a legal act and the legal content that comes into being through that act."@en)
ObjectPropertyDomain(:0001100 :0001000)
ObjectPropertyRange(:0001100 :0001001)

Declaration(ObjectProperty(:0001101))
AnnotationAssertion(rdfs:label :0001101 "established by"@en)
AnnotationAssertion(skos:definition :0001101 "A relation between legal content and the legal act through which it came into being."@en)
InverseObjectProperties(:0001100 :0001101)

Declaration(ObjectProperty(:0001102))
AnnotationAssertion(rdfs:label :0001102 "performed under"@en)
AnnotationAssertion(skos:definition :0001102 "A relation between a legal act and pre-existing legal content that authorizes or governs it, such as an enabling statute or a rule of procedure."@en)
ObjectPropertyDomain(:0001102 :0001000)
ObjectPropertyRange(:0001102 :0001001)

Declaration(ObjectProperty(:0001103))
AnnotationAssertion(rdfs:label :0001103 "performed by means of"@en)
AnnotationAssertion(skos:definition :0001103 "A relation between a legal act and a legal document that participates in it as the instrument through which the act is performed, as when a deed is executed or a statutory form is signed before witnesses."@en)
AnnotationAssertion(rdfs:comment :0001103 "Documents do not act; persons and organizations do. A document related by this relation is an operative (dispositive) instrument: the law makes the writing part of how the act is done. Contrast evidences, which holds of documents that merely record or attest to an act."@en)
SubObjectPropertyOf(:0001103 obo:BFO_0000057)
ObjectPropertyDomain(:0001103 :0001000)
ObjectPropertyRange(:0001103 :0001002)

Declaration(ObjectProperty(:0001104))
AnnotationAssertion(rdfs:label :0001104 "evidences"@en)
AnnotationAssertion(skos:definition :0001104 "A relation between a material entity, such as a legal document, and a legal act, legal content, or other entity whose existence or occurrence it records or attests to."@en)
AnnotationAssertion(rdfs:comment :0001104 "Evidencing is not participation: the evidencing entity may come into existence after the act, and the act may occur with no document at all. Nothing about an act, role, or position may be inferred from the existence of an evidencing document alone. An instrument usually also evidences the act performed by means of it, so the two relations are not disjoint."@en)
ObjectPropertyDomain(:0001104 obo:BFO_0000040)


############################
#   Proposed for 0.3.0 (draft): norm-generating practice and nullity
############################

# ---------------------------------------------------------------- 0.2.0 relations
# ---------------------------------------------------------------- 0.2.0: nullity
# ---------------------------------------------------------------- 0.2.0: practice as a source
AnnotationAssertion(<http://purl.org/dc/terms/coverage> :0001008 "customary-law")
AnnotationAssertion(<http://purl.org/dc/terms/coverage> :0001008 "international-law")
AnnotationAssertion(rdfs:comment :0001000 "Version 0.2.0: a legal act is now a purported legal act that succeeds. A void act has the outward form of a legal act but is not one. Voidable acts are legal acts until annulled."@en)
AnnotationAssertion(rdfs:comment :0001001 "Version 0.2.0: legal content no longer has to be established by an act. Customary law and settled case law arise from practice. Every item of legal content has some origin, an act or a practice; this is now an axiom."@en)
AnnotationAssertion(rdfs:comment :0001008 "BFO placement (LOF-P-004): a practice unfolds over time and has temporal parts (each instance of the conduct), so it is a process, like a legal act. It is not a legal act: no single performance brings the content into being, and no participant need intend to make law. Covers custom (usus and opinio juris; ICJ Statute Art. 38(1)(b)), the customary law of indigenous and religious communities, and settled case law (jurisprudence constante), whose parts are adjudicative acts (LOF-ODP-008). Whether a practice gives rise to legal content is settled by the recognition criterion of a legal order (LOF-ODP-007), not by this pattern."@en)
AnnotationAssertion(rdfs:comment :0001009 "Kelsen's general norm. Statutes, regulations, customary rules, and binding holdings. The distinction matters for precedent: an adjudicative act gives rise to particular content (the ruling) and, where the legal order makes holdings binding, to general content as well (LOF-ODP-008)."@en)
AnnotationAssertion(rdfs:comment :0001010 "Kelsen's individual norm. Contract terms, a court's order, a licence, an administrative decision addressed to a named party. A provision that names a person and also governs an open class should be split into two items of content."@en)
AnnotationAssertion(rdfs:comment :0001011 "The genus of valid and void acts. A signing by someone without authority, a vote without a quorum, and a marriage within the prohibited degrees all have the outward form of a legal act, and they are what nullity is about: one cannot annul or declare void something that was never presented as an act. Whether a purported act is a legal act is decided by the legal order under which it is performed (LOF-ODP-007), often by adjudication (LOF-ODP-008)."@en)
AnnotationAssertion(rdfs:comment :0001012 "Void (nullity, nullite absolue, Nichtigkeit) is not a kind of legal act but a failure to be one, so it is disjoint from legal act. A void act establishes nothing; what it purports to establish is related to it by 'purports to establish', which does not imply that legal content exists. Void acts are asserted, not inferred: OWL cannot infer from the absence of recorded content that an act was void. Facts about a void act can still have legal consequences (restitution, liability in tort); those are positions grounded in other content, triggered by the void act as an occurrent (LOF-ODP-004)."@en)
AnnotationAssertion(rdfs:comment :0001013 "Voidable acts (nullite relative, Anfechtbarkeit) are legal acts and have their effects until annulled. Typical grounds: a minor's contract, a contract induced by fraud, mistake, or duress. The power to annul is a second-order legal position (LOF-ODP-003) exercised in the annulment; it is not linked here, because LOF-ODP-001 does not depend on LOF-ODP-003. Inferred for any act that is the object of an annulment."@en)
AnnotationAssertion(rdfs:comment :0001014 "Constitutive: before the annulment the voidable act had its effects. Covers rescission and avoidance by a party (disaffirmance of a minor's contract, avoidance for fraud) and annulment by a court. Whether the effects end from the outset or from the annulment is recorded by the two subproperties of 'annuls'; LOF-ODP-005 records the resulting periods of force."@en)
AnnotationAssertion(rdfs:comment :0001015 "Declaratory, not constitutive: the declared act was void before the declaration. Its range is purported legal act, not void act, so that a declaration does not by itself make the reasoner classify the declared act as void. Whether a declaration is authoritative is recorded as for precedence determinations (LOF-ODP-006) or rulings (LOF-ODP-008)."@en)
AnnotationAssertion(rdfs:comment :0001105 "Generalizes 'establishes' to practices. A legal act establishes content; a practice gives rise to content without establishing it. 'Establishes' is a subproperty."@en)
AnnotationAssertion(rdfs:comment :0001107 "The range is generically dependent continuant, not legal content: the terms a void contract purports to establish exist as information (they can be read and quoted), but they are not legal content. For a successful act, 'establishes' implies this relation."@en)
AnnotationAssertion(rdfs:label :0001008 "norm-generating practice"@en)
AnnotationAssertion(rdfs:label :0001009 "general legal content"@en)
AnnotationAssertion(rdfs:label :0001010 "particular legal content"@en)
AnnotationAssertion(rdfs:label :0001011 "purported legal act"@en)
AnnotationAssertion(rdfs:label :0001012 "void act"@en)
AnnotationAssertion(rdfs:label :0001013 "voidable legal act"@en)
AnnotationAssertion(rdfs:label :0001014 "annulment"@en)
AnnotationAssertion(rdfs:label :0001015 "declaration of nullity"@en)
AnnotationAssertion(rdfs:label :0001105 "gives rise to"@en)
AnnotationAssertion(rdfs:label :0001106 "arises from"@en)
AnnotationAssertion(rdfs:label :0001107 "purports to establish"@en)
AnnotationAssertion(rdfs:label :0001108 "annuls"@en)
AnnotationAssertion(rdfs:label :0001109 "annuls with retroactive effect"@en)
AnnotationAssertion(rdfs:label :0001110 "annuls with prospective effect"@en)
AnnotationAssertion(rdfs:label :0001111 "declares void"@en)
AnnotationAssertion(skos:altLabel :0001008 "custom"@en)
AnnotationAssertion(skos:altLabel :0001012 "null act"@en)
AnnotationAssertion(skos:altLabel :0001014 "avoidance"@en)
AnnotationAssertion(skos:altLabel :0001014 "rescission"@en)
AnnotationAssertion(skos:altLabel :0001109 "annuls ex tunc"@en)
AnnotationAssertion(skos:altLabel :0001110 "annuls ex nunc"@en)
AnnotationAssertion(skos:definition :0001000 "A purported legal act that succeeds in bringing into being, modifying, or terminating legally significant entities, as the legal order under which it is performed recognizes."@en)
AnnotationAssertion(skos:definition :0001001 "A generically dependent continuant that arises from some legal act or norm-generating practice and that specifies legally significant entities, such as the provisions of a statute, the terms of a contract, a rule of customary law, or the holding of a judgment where holdings bind."@en)
AnnotationAssertion(skos:definition :0001008 "A process consisting of the convergent conduct of the members of some community, accompanied by their acceptance of that conduct as required or permitted, that gives rise to legal content."@en)
AnnotationAssertion(skos:definition :0001009 "Legal content that governs an open class of persons or cases, not identified by name."@en)
AnnotationAssertion(skos:definition :0001010 "Legal content that governs determinate persons or cases, identified as such."@en)
AnnotationAssertion(skos:definition :0001011 "A process, having one or more persons or organizations as participants, that is performed as, or presented as, a legal act."@en)
AnnotationAssertion(skos:definition :0001012 "A purported legal act that, from the outset, brings about none of the legal effects it purports to bring about."@en)
AnnotationAssertion(skos:definition :0001013 "A legal act whose effects some party may bring to an end by an annulment."@en)
AnnotationAssertion(skos:definition :0001014 "A legal act that brings to an end the effects of some voidable legal act."@en)
AnnotationAssertion(skos:definition :0001015 "A legal act that declares that some purported legal act was void."@en)
AnnotationAssertion(skos:definition :0001105 "A relation between an occurrent and legal content that comes into being through it."@en)
AnnotationAssertion(skos:definition :0001106 "A relation between legal content and an occurrent through which it came into being."@en)
AnnotationAssertion(skos:definition :0001107 "A relation between a purported legal act and the information content it is performed or presented as establishing."@en)
AnnotationAssertion(skos:definition :0001108 "A relation between a legal act and a voidable legal act whose effects it brings to an end."@en)
AnnotationAssertion(skos:definition :0001109 "Annuls, such that the annulled act is treated as never having had its effects."@en)
AnnotationAssertion(skos:definition :0001110 "Annuls, such that the annulled act's effects end at the annulment and those before it stand."@en)
AnnotationAssertion(skos:definition :0001111 "A relation between a legal act and a purported legal act that it declares to have been void."@en)
AnnotationAssertion(skos:example :0001008 "the general practice of states, accepted as law, of according immunity to diplomatic agents; a pastoral community's practice of seasonal grazing rights"@en)
